<diagram id="opcion9id" name="9. Mostrar la tabla de transicion del AFD generado"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connectable="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="n1" value="Inicio:&#10;Mostrar tabla de transicion&#10;del AFD generado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="estados &lt;- ordenar(Q); simbolos &lt;- ordenar(Sigma)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n3" value="Calcular ancho de columna segun&#10;el nombre de estado mas largo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n4" value="Imprimir encabezado con cada&#10;simbolo de Sigma como columna" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n5" value="Para cada estado: marcar &#x27;-&gt;&#x27; si es el inicial,&#10;&#x27;*&#x27; si es final; imprimir delta(estado,simbolo)&#10;(o &#x27;-&#x27; si no esta definida) en cada columna" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n6" value="Subproceso:&#10;Regresar a Flujo Principal" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n7" value="Fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="nNote" value="Es la misma logica que &#x27;Mostrar la definicion&#10;y la tabla&#x27; (opcion 5) usa para un AFD, aplicada&#10;ahora al AFD generado por la conversion (opcion 7),&#10;que siempre es completo y determinista." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#8a6d3b;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="380" height="120" as="geometry"/></mxCell>
