<mxCell id="e12" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#82B366;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n20" value="Q_afd &lt;- todos los macroestados descubiertos&#10;(las etiquetas asignadas)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e20" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n4" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n21" value="F_afd &lt;- { etiquetas[s] : s en orden,&#10;s interseccion F_afnd no vacia }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n22" value="Construir AFD(nombre + &#x27;_AFD&#x27;, Q_afd, Sigma, delta_afd,&#10;etiquetas[macroestado_inicial], F_afd)&#10;afd_generado.validado &lt;- True (completo y determinista por construccion)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="340" height="80" as="geometry"/></mxCell>
