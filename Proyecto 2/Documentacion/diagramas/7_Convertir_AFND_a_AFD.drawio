<diagram id="opcion7id" name="7. Convertir el AFND cargado en un AFD equivalente"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connectable="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1970" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="n1" value="Inicio:&#10;Convertir AFND a AFD&#10;(construccion de subconjuntos)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="macroestado_inicial &lt;- {q0}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n3" value="etiquetas &lt;- {macroestado_inicial: &#x27;A&#x27;}&#10;orden &lt;- [macroestado_inicial]&#10;pendientes &lt;- cola([macroestado_inicial]); delta_afd &lt;- {}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n4" value="¿pendientes&#10;no esta vacia?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n5" value="actual &lt;- pendientes.sacar_primero()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e5" value="Si" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n5b" value="simbolos_restantes &lt;- Sigma (ordenado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e5b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n5b"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n6" value="¿Quedan simbolos&#10;en simbolos_restantes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5b" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n7" value="simbolo &lt;- siguiente de simbolos_restantes (se retira)&#10;destino &lt;- union de delta_afnd(estado,simbolo)&#10;para cada &#x27;estado&#x27; en el macroestado &#x27;actual&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="e7" value="Si" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n8" value="¿destino no esta&#10;en etiquetas?&#10;(macroestado nuevo)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n9" value="etiquetas[destino] &lt;- siguiente_etiqueta()&#10;(A, B, ..., Z, AA, AB, ...)&#10;orden.agregar(destino); pendientes.encolar(destino)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="1010" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="e9" value="Si" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n10" value="delta_afd[(etiquetas[actual], simbolo)] &lt;- etiquetas[destino]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="340" height="60" as="geometry"/></mxCell>
