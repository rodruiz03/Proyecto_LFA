<mxCell id="n23" value="tabla_equivalencias &lt;- { etiquetas[s]: s para cada s en orden }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1630" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n24" value="Subproceso:&#10;Regresar a Flujo Principal" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n25" value="Fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1850" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="nNote1" value="El conjunto vacio ∅ se trata como un&#10;macroestado mas: si &#x27;destino&#x27; es ∅, se le&#10;asigna su propia etiqueta y, como la union&#10;de transiciones de ningun estado es siempre&#10;∅, todas sus transiciones regresan a si&#10;mismo -&gt; actua como estado de trampa." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#8a6d3b;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="1150" width="380" height="140" as="geometry"/></mxCell>
<mxCell id="nNote2" value="Por construccion, el AFD generado es&#10;siempre completo y determinista: el ciclo&#10;calcula, para cada macroestado alcanzado&#10;y cada simbolo de Sigma, EXACTAMENTE&#10;un destino (delta_afd nunca queda&#10;incompleto ni ambiguo)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#8a6d3b;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="1320" width="380" height="140" as="geometry"/></mxCell>
