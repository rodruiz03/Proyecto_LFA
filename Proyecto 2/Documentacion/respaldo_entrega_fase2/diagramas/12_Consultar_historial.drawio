<mxCell id="n4" value="Para cada registro (en el orden en que se&#10;evaluaron), numerado desde 1:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="320" height="70" as="geometry"/></mxCell>
