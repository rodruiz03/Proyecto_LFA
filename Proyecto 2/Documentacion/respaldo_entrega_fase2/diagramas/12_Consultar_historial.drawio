<mxCell id="n3" value="Mostrar: &#x27;Aun no se ha evaluado&#10;ninguna cadena con el automata actual&#x27;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="320" height="70" as="geometry"/></mxCell>
