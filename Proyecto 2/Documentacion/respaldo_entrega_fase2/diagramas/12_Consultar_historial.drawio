<mxCell id="nNote" value="El historial se reinicia (queda vacio) cada vez que&#10;se crea o carga un automata nuevo (opciones 1 a 4)&#10;o se usa la opcion 14: solo contiene evaluaciones&#10;del automata ACTUALMENTE activo." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#8a6d3b;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="320" width="380" height="120" as="geometry"/></mxCell>
